{
  "name": "moonwitness-xii-global-championships",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run test && npm run audit:posters && npm run typecheck && next build",
    "start": "next start --hostname 0.0.0.0",
    "preview": "next start --hostname 0.0.0.0",
    "test": "node scripts/check-content.mjs && node scripts/test-workspace.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run build",
    "test:browser": "playwright test",
    "audit:posters": "node scripts/audit-posters.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.2"
  }
}
