{
  "name": "moonwitness-xii-global-championships",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run test && npm run audit:posters && prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "preview": "next start --hostname 0.0.0.0",
    "test": "node scripts/check-content.mjs && node scripts/test-workspace.mjs",
    "check": "npm run build",
    "test:browser": "playwright test",
    "audit:posters": "node scripts/audit-posters.mjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.0",
    "next": "16.2.6",
    "@prisma/client": "^6.19.0",
    "lucide-react": "^1.27.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "@playwright/test": "^1.56.1",
    "prisma": "^6.19.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
